<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundled app's Info.plist by Tauri. NSMicrophoneUsageDescription
     is required for the woodshed-recorder sidecar to capture the mic. System-audio
     capture (ScreenCaptureKit) is gated by the Screen Recording TCC prompt at
     runtime and needs no Info.plist key. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Woodshed records meeting audio to transcribe your notes. Recording only starts for events you're in, and a recording indicator is always shown.</string>
</dict>
</plist>
