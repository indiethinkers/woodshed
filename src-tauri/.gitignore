# Cargo build output
/target/

# Compiled woodshed-recorder sidecar (rebuilt by scripts/build-recorder.sh)
/binaries/

# Auto-generated schemas (regenerated by tauri-build on every build)
/gen/schemas/

# WebView2 runtime cache (macOS)
/.WebKit/

# Local secrets (OAuth client JSONs, app passwords, etc.) — never commit
/.secrets/
