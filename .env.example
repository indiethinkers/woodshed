# Optional development-only fallbacks. Prefer Settings or local Hermes profile
# discovery. Release builds store custom Hermes keys in Woodshed's owner-only
# app-data credential file.
WOODSHED_AGENT_API_KEY=

# Optional single-account Gmail development fallback. Normal app accounts are
# configured in Settings and their App Passwords are stored in Woodshed's
# owner-only app-data credential file.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
